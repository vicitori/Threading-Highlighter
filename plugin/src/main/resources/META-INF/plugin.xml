<idea-plugin>
    <id>io.github.vicitori.threading.highlighter</id>
    <name>Threading Highlighter</name>
    <vendor>Vicitori</vendor>

    <description><![CDATA[
        Visualizes IntelliJ Platform threading contracts in your code.
        <br/><br/>
        Shows gutter icons where EDT/non-EDT assertions and slow operation checks occur at runtime.
        Helps developers understand and debug threading requirements in IntelliJ Platform plugins.
        <br/><br/>
        <b>Requires:</b> Running IDE with the Threading Highlighter Java agent.
    ]]></description>

    <change-notes><![CDATA[
        <h3>0.1.0-SNAPSHOT</h3>
        <ul>
            <li>Gutter markers for EDT, non-EDT, and slow operation assertions</li>
            <li>Traces loaded off the UI thread and served from an immutable O(1) index</li>
            <li>Automatic trace reload on project open and on trace file changes (debounced)</li>
            <li>Warning when a file was edited after its trace was recorded</li>
        </ul>
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.kotlin</depends>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <annotator language="kotlin"
                   implementationClass="io.github.vicitori.threading.highlighter.plugin.annotator.ThreadingMarkerAnnotator"/>
        <annotator language="JAVA"
                   implementationClass="io.github.vicitori.threading.highlighter.plugin.annotator.ThreadingMarkerAnnotator"/>

        <notificationGroup id="Threading Highlighter" displayType="BALLOON"/>

        <postStartupActivity
            implementation="io.github.vicitori.threading.highlighter.plugin.services.TraceFileWatcher"/>

        <toolWindow id="Threading Traces" anchor="bottom"
                    factoryClass="io.github.vicitori.threading.highlighter.plugin.toolwindow.TraceToolWindowFactory"/>

        <statusBarWidgetFactory id="ThreadingHighlighter.StatusBar"
                                implementation="io.github.vicitori.threading.highlighter.plugin.statusbar.TraceStatusBarWidgetFactory"/>
    </extensions>

    <actions>
        <group id="ThreadingHighlighter.Group" text="Threading Highlighter" popup="true">
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <action id="ThreadingHighlighter.ReloadTrace"
                    class="io.github.vicitori.threading.highlighter.plugin.actions.ReloadTraceAction"
                    text="Reload Threading Traces"
                    description="Reload trace files from .ij-threading-highlighter directory and refresh gutter icons"/>
            <action id="ThreadingHighlighter.ShowTraceSummary"
                    class="io.github.vicitori.threading.highlighter.plugin.actions.ShowTraceSummaryAction"
                    text="Show Trace Summary"
                    description="Display diagnostic summary of loaded traces (for debugging)"/>
            <action id="ThreadingHighlighter.ToggleMarkers"
                    class="io.github.vicitori.threading.highlighter.plugin.actions.ToggleMarkersAction"
                    text="Hide Threading Markers"
                    description="Show or hide all threading gutter markers without reloading traces"/>
            <action id="ThreadingHighlighter.CopyAgentArgs"
                    class="io.github.vicitori.threading.highlighter.plugin.actions.CopyAgentArgsAction"
                    text="Enable Agent..."
                    description="Show ready-to-use -javaagent VM options for the bundled agent with setup steps"/>
        </group>
    </actions>
</idea-plugin>
